opam-version: "2.0"
synopsis:
  "Shared semantics for US equities, options and futures venue simulators"
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/equities-core"
bug-reports: "https://github.com/winterchill-trading/equities-core/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "fixed-decimal"
  "exchange-core"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/equities-core.git"
